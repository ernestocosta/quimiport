# Ambiente
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://quimiport:quimiport@localhost:5432/quimiport?schema=public

# Origens liberadas no CORS (separadas por vírgula). Use * para liberar todas.
CORS_ORIGIN=http://localhost:3000

# Popula o banco com dados de exemplo ao subir o container (true/false)
SEED_ON_START=false
