# Variáveis opcionais do docker-compose (os valores abaixo já são o padrão)
POSTGRES_USER=quimiport
POSTGRES_PASSWORD=quimiport
POSTGRES_DB=quimiport
DB_PORT=5432
API_PORT=3333
WEB_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*
SEED_ON_START=true
# URL que o NAVEGADOR usa para chamar a API (embutida no build do painel)
VITE_API_URL=http://localhost:3333
GRAFANA_PASSWORD=admin
